# Pinata IPFS configuration
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY_BASE_URL=https://gateway.pinata.cloud/ipfs

# Meta/tBridge API configuration (optional)
META_API_URL=https://api.meta.global/v1
META_API_KEY=your_meta_api_key_here

# TRON network configuration
TRON_RPC_URL=https://api.trongrid.io

# Application configuration
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SUPPORTED_NETWORKS=mainnet,nile
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=5

# Optional server-side limits
MAX_UPLOAD_SIZE_MB=5
UPLOAD_TIMEOUT_MS=30000
